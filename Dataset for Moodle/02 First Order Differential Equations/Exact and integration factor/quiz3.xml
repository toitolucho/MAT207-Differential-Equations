<quiz>

<question type="category">
    <category><text>$course$/MAT207/Exactas_PVI_Ejercicio3</text></category>
</question>

<question type="multichoice">
    <name><text>P01. Identificación de M(x,y)</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Para la ecuación \((3x^2 + 6xy^2)dx + (6x^2 y + 4y^3)dy = 0\), ¿cuál es la expresión de \( M(x,y) \) identificada en su hoja?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 3x^2 + 6xy^2 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 6x^2 y + 4y^3 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^2 + 6y^2 \)]]></text></answer>
</question>

<question type="multichoice">
    <name><text>P02. Identificación de N(x,y)</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>¿Cuál es la expresión de \( N(x,y) \) según el Paso 2 de su desarrollo?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 6x^2 y + 4y^3 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^2 + 6xy^2 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 6xy + 4y^3 \)]]></text></answer>
</question>

<question type="multichoice">
    <name><text>P03. Resultado de la prueba de exactitud</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Al realizar la prueba de exactitud (Paso 3), ¿qué expresión obtuvo para las derivadas parciales cruzadas \( M_y \) y \( N_x \)?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 12xy \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 6xy \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 12x^2 y \)]]></text></answer>
</question>

<question type="multichoice">
    <name><text>P04. Integración de M respecto a x</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>En el Paso 4, ¿cuál es el resultado de \( \int M(x,y) dx \) (sin considerar aún \( h(y) \))?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( x^3 + 3x^2 y^2 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^3 + 6x^2 y^2 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( x^3 + 6xy^2 \)]]></text></answer>
</question>

<question type="truefalse">
    <name><text>P05. Incorporación de h(y)</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>¿Se debe sumar una función desconocida \( h(y) \) tras la integración parcial porque la variable \( y \) actuó como constante?</p>]]></text>
    </questiontext>
    <answer fraction="100"><text>true</text></answer>
    <answer fraction="0"><text>false</text></answer>
</question>

<question type="multichoice">
    <name><text>P06. Derivada de g respecto a y</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Al derivar su expresión parcial de \( g(x,y) \) respecto a \( y \), ¿qué término obtuvo (sin incluir a \( h'(y) \))?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 6x^2 y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^2 y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 6xy^2 \)]]></text></answer>
</question>

<question type="multichoice">
    <name><text>P07. Simplificación algebraica</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Al igualar su derivada con \( N(x,y) \) (Paso 6), ¿qué término se simplifica (se elimina) en ambos lados de la ecuación?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 6x^2 y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 4y^3 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^2 \)]]></text></answer>
</question>

<question type="multichoice">
    <name><text>P08. Determinación de h'(y)</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>¿Cuál es la expresión resultante para \( h'(y) \) tras la simplificación?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 4y^3 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( y^4 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[0]]></text></answer>
</question>

<question type="shortanswer">
    <name><text>P09. Constante de integración C</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Evaluando la condición inicial \( y(1) = 0 \), ¿cuál es el valor numérico de la constante \( C \)?</p>]]></text>
    </questiontext>
    <answer fraction="100"><text>1</text></answer>
</question>

<question type="multichoice">
    <name><text>P10. Solución Final del PVI</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>¿Cuál es la solución final que coincide con su desarrollo manuscrito?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( x^3 + 3x^2 y^2 + y^4 = 1 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( x^3 + 3x^2 y^2 + y^4 = 0 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^2 + 6x^2 y^2 + y^4 = 1 \)]]></text></answer>
</question>

</quiz>