<question type="multichoice">
    <name><text>P01. Identificación de M(x,y)</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Para la ecuación diferencial dada, ¿cuál es la expresión de \( M(x,y) \) que acompaña al diferencial \( dx \)?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( e^y + \cos x \cos y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( x e^y - \sin x \sin y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( e^y - \sin x \sin y \)]]></text></answer>
</question>

