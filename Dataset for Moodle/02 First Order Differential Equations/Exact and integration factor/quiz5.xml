<question type="multichoice">
    <name><text>P01. Identificación de M(x,y)</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Para la ecuación diferencial \((3x^2 + 3xy^2)dx + (3x^2y - 3y^2 + 2y)dy = 0\), ¿cuál es la expresión de \( M(x,y) \)?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 3x^2 + 3xy^2 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^2y - 3y^2 + 2y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^2 + 3y^2 \)]]></text></answer>
</question>

<question type="multichoice">
    <name><text>P02. Identificación de N(x,y)</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>¿Cuál es la expresión de \( N(x,y) \) identificada en su Paso 2?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 3x^2y - 3y^2 + 2y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^2y + 3y^2 - 2y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^2 + 3xy^2 \)]]></text></answer>
</question>

<question type="multichoice">
    <name><text>P03. Derivada parcial común</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Al realizar la prueba de exactitud (Paso 3), ¿qué resultado común obtuvo para \( M_y \) y \( N_x \)?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 6xy \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3xy \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 6x^2y \)]]></text></answer>
</question>

<question type="multichoice">
    <name><text>P04. Integración parcial de M respecto a x</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>En el Paso 4, al calcular \( \int M(x,y) dx \), ¿cuál es la expresión obtenida para \( g(x,y) \) sin incluir la función \( h(y) \)?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( x^3 + \frac{3}{2}x^2y^2 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( x^3 + 3x^2y^2 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^3 + \frac{3}{2}xy^2 \)]]></text></answer>
</question>

<question type="truefalse">
    <name><text>P05. Incorporación de h(y)</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>¿En su desarrollo manuscrito sumó una función desconocida \( h(y) \) tras integrar parcialmente respecto a \( x \)?</p>]]></text>
    </questiontext>
    <answer fraction="100"><text>true</text></answer>
    <answer fraction="0"><text>false</text></answer>
</question>

<question type="multichoice">
    <name><text>P06. Derivada de g respecto a y</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Al derivar su expresión \( g(x,y) \) respecto a \( y \) (Paso 5), ¿cuáles son los términos que resultan antes de sumar \( h'(y) \)?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 3x^2y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 6x^2y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3x^2 \)]]></text></answer>
</question>

<question type="multichoice">
    <name><text>P07. Término simplificado</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Al igualar su derivada parcial con el término \( N(x,y) \), ¿qué expresión algebraica se simplifica en ambos lados de la ecuación?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( 3x^2y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( -3y^2 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 2y \)]]></text></answer>
</question>

<question type="multichoice">
    <name><text>P08. Expresión de h'(y)</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Tras la simplificación en su hoja, ¿cuál es la expresión resultante para la derivada de la función desconocida \( h'(y) \)?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( -3y^2 + 2y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( 3y^2 - 2y \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[0]]></text></answer>
</question>

<question type="shortanswer">
    <name><text>P09. Cálculo de la constante C</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>Evaluando la condición inicial \( y(0) = 1 \), ¿cuál es el valor numérico de la constante \( C \)?</p>]]></text>
    </questiontext>
    <answer fraction="100"><text>0</text></answer>
</question>

<question type="multichoice">
    <name><text>P10. Solución Final del PVI</text></name>
    <questiontext format="html">
        <text><![CDATA[<p>¿Cuál es la solución final implícita que coincide con su desarrollo?</p>]]></text>
    </questiontext>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[\( x^3 + \frac{3}{2}x^2y^2 - y^3 + y^2 = 0 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( x^3 + 3x^2y^2 - y^3 + y^2 = 1 \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( x^3 + \frac{3}{2}x^2y^2 + y^3 - y^2 = 0 \)]]></text></answer>
</question>

