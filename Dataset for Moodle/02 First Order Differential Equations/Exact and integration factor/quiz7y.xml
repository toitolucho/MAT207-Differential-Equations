    <answer fraction="-25" format="html"><text><![CDATA[\( \frac{x}{\sqrt{1+x^2}} + 2x - \frac{1}{x} \)]]></text></answer>
    <answer fraction="-25" format="html"><text><![CDATA[\( y\sqrt{1+x^2} + 2xy - \frac{1}{x} \)]]></text></answer>
</question>

